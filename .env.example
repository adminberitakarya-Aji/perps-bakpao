# Copy file ini ke .env dan isi nilainya. JANGAN commit .env ke git.

# Private key dari API WALLET (bukan wallet utama).
# Buat di app.hyperliquid.xyz -> More -> API, lalu approve agent wallet.
HL_PRIVATE_KEY=

# Alamat wallet utama kamu (yang menyimpan dana / posisi).
HL_ACCOUNT_ADDRESS=

# true = testnet (wajib dipakai dulu sebelum live), false = mainnet
HL_USE_TESTNET=true

# --- Alert Telegram (opsional; kosongkan keduanya untuk menonaktifkan) ---
# 1. Buat bot via @BotFather di Telegram -> dapatkan token.
# 2. Kirim pesan apa pun ke bot kamu, lalu buka
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> cari "chat":{"id":...}
# 3. Isi kedua variabel di bawah. Uji kirim: python -m src.utils.notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
